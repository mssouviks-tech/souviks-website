{
  "name": "souviks-static-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:js": "node scripts/js/minify.js && python3 scripts/js/refresh_versions.py",
    "check:js": "node scripts/js/check-syntax.js",
    "lint:js": "eslint \"assets/js/site-core.js\" \"assets/js/attribution.js\" \"assets/js/catalogue-core.js\" \"assets/js/account/**/*.js\" \"assets/js/products/**/*.js\" \"assets/js/product/**/*.js\" \"assets/js/request-quote/**/*.js\" \"assets/js/components/**/*.js\"",
    "format:js": "prettier --write \".prettierrc.json\" \"scripts/js/*.js\" \"eslint.config.js\" \"package.json\"",
    "format:check": "prettier --check \".prettierrc.json\" \"scripts/js/*.js\" \"eslint.config.js\" \"package.json\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.0"
  }
}
