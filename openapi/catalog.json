    "souviks_get_catalogue": {
      "name": "souviks_get_catalogue",
      "title": "Get Souviks catalogue",
      "description": "Retrieve a machine-readable Souviks catalogue resource: products, brands, categories, vehicles or search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
