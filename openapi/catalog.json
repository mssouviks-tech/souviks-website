{
  "openapi": "3.0.3",
  "info": {
    "title": "Souviks Catalogue Data API",
    "version": "1.3.0",
    "description": "Machine-readable catalogue resources published by Souviks for commercial vehicle spare-parts discovery."
  },
  "servers": [
    {
      "url": "https://www.souviks.co.in"
    }
  ],
  "paths": {
    "/assets/data/products.json": {
      "get": {
        "operationId": "getProducts",
        "summary": "Get product catalogue",
        "responses": {
          "200": {
            "description": "Get product catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
