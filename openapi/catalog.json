    "souviks_navigate": {
      "name": "souviks_navigate",
      "title": "Navigate Souviks",
      "description": "Navigate to a Souviks catalogue section: home, products, brands, categories or vehicles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
